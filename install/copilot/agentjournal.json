{
  "version": 1,
  "hooks": {
    "userPromptSubmitted": [
      { "type": "command", "command": "node /ABSOLUTE/PATH/TO/agentjournal-hook.mjs pin", "timeoutSec": 10 }
    ],
    "postToolUse": [
      { "type": "command", "command": "node /ABSOLUTE/PATH/TO/agentjournal-hook.mjs journal", "timeoutSec": 10 }
    ],
    "postToolUseFailure": [
      { "type": "command", "command": "node /ABSOLUTE/PATH/TO/agentjournal-hook.mjs journal", "timeoutSec": 10 }
    ],
    "preCompact": [
      { "type": "command", "command": "node /ABSOLUTE/PATH/TO/agentjournal-hook.mjs precompact", "timeoutSec": 10 }
    ],
    "sessionStart": [
      { "type": "command", "command": "node /ABSOLUTE/PATH/TO/agentjournal-hook.mjs wake-flat", "timeoutSec": 10 }
    ]
  }
}
